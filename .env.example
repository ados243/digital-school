# Copiez ce fichier vers .env et renseignez vos valeurs.
# Le fichier .env n'est PAS versionné (voir .gitignore).

# ---------------------------------------------------------------------------
# Développement local
# ---------------------------------------------------------------------------
DJANGO_SECRET_KEY=changez-moi-en-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# ---------------------------------------------------------------------------
# Production Coolify (OVH)
# ---------------------------------------------------------------------------
# DJANGO_DEBUG=0
# DJANGO_SECRET_KEY=generer-au-moins-50-caracteres-aleatoires
# DJANGO_ALLOWED_HOSTS=votredomaine.com,www.votredomaine.com
# CSRF_TRUSTED_ORIGINS=https://votredomaine.com,https://www.votredomaine.com
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_PRELOAD=1
# PORT=8000
# GUNICORN_WORKERS=3
# GUNICORN_TIMEOUT=120
#
# Base : coller l’URL interne Coolify (Make this database available…)
# DATABASE_URL=mysql://user:motdepasse@nom-du-conteneur-mysql:3306/digital_school
#
# Volumes persistants Coolify :
#   /app/media          → photos élèves / avatars (à ne PAS servir publiquement par nginx)
#   /app/private_media  → vidéos de cours
#
# Healthcheck Coolify : GET /sante/

DB_ENGINE=django.db.backends.mysql
DB_NAME=digital_school
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

WHATSAPP_TIMEOUT=20
WHATSAPP_META_API_VERSION=v21.0
# Modèles Meta approuvés (Digital School)
WHATSAPP_META_TEMPLATE_PAIEMENT=recu_de_paiement
WHATSAPP_META_TEMPLATE_RELANCE=relance_minerval
WHATSAPP_META_TEMPLATE_ANNONCE=annonce_ecole
WHATSAPP_META_TEMPLATE_OTP=code_verification
WHATSAPP_META_LANGUAGE=fr

# Visioconférence (Jitsi Meet / JaaS) — cours en direct
# Mode public (défaut) :
# JITSI_PROVIDER=public
# JITSI_DOMAIN=meet.jit.si
#
# Mode production JaaS (8x8) :
# JITSI_PROVIDER=jaas
# JITSI_DOMAIN=8x8.vc
# JITSI_JAAS_APP_ID=vpaas-magic-cookie-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# JITSI_JAAS_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# JITSI_JAAS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# JITSI_JAAS_JWT_TTL_SECONDS=3600
JITSI_PROVIDER=public
JITSI_DOMAIN=meet.jit.si
JITSI_ROOM_PREFIX=ds

# E-mail (optionnel — l'authentification passe par WhatsApp / Bird)
# Dev : console. Prod : SMTP uniquement si vous envoyez encore des e-mails hors auth.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Digital School <noreply@votredomaine.com>

# ---------------------------------------------------------------------------
# Bird — e-mail transactionnel (et reçus WhatsApp si le fournisseur Bird est choisi)
# Python 3.9 : API REST (le SDK officiel demande 3.10+).
# L'OTP connexion / inscription utilise Meta, pas Bird.
# ---------------------------------------------------------------------------
BIRD_API_KEY=
BIRD_WHATSAPP_PAIEMENT_TEMPLATE=bird_delivery_update
BIRD_WHATSAPP_LANGUAGE=fr
PASSWORD_RESET_TIMEOUT=3600
LOGIN_LOCKOUT_LIMIT=5
LOGIN_LOCKOUT_MINUTES=15
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RENVOI_COOLDOWN_SECONDS=60
OTP_RENVOI_MAX=5
# 2FA WhatsApp à la connexion (1 = activé).
MFA_WHATSAPP=1
# Code WhatsApp à l'inscription du compte (1 = activé).
INSCRIPTION_WHATSAPP=1
# Fermeture automatique des sessions après 15 minutes d'inactivité.
SESSION_IDLE_SECONDS=900

# ---------------------------------------------------------------------------
# Vidéos de cours
# Local / OVH sans R2 : fichiers dans private_media/ (lecture authentifiée).
# Cloudflare R2 recommandé dès que le volume vidéo augmente.
# ---------------------------------------------------------------------------
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=digital-school-videos
# AWS_S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# AWS_S3_REGION_NAME=auto
# AWS_QUERYSTRING_EXPIRE=3600
# AWS_S3_CUSTOM_DOMAIN=
# COURS_VIDEO_MAX_MB=70
# COURS_VIDEO_LOCATION=cours_videos
# RESSOURCE_FICHIER_MAX_MB=25

# Proxys (IP du reverse proxy Coolify / nginx). X-Forwarded-For ignoré sinon.
TRUSTED_PROXIES=127.0.0.1,::1

# Mobile Money — webhook opérateur (chaîne secrète ; laisser vide = webhook désactivé)
MOBILE_MONEY_WEBHOOK_TOKEN=
# Authentification webhook : en-tête HTTP X-Webhook-Token uniquement (pas en query string).
# MOBILE_MONEY_USSD_AIRTEL=*501#
# MOBILE_MONEY_USSD_ORANGE=*144#
# MOBILE_MONEY_USSD_MPESA=*150#

# Sentry (optionnel)
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1
