# Copiez ce fichier vers .env et renseignez vos valeurs locales.
# Le fichier .env n'est PAS versionné (voir .gitignore).

DJANGO_SECRET_KEY=changez-moi-en-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=

DB_ENGINE=django.db.backends.mysql
DB_NAME=digital_school
DB_USER=root
